{
  "name":"groundops-war-thunder-rb-atlas",
  "version":"1.0.0",
  "private":true,
  "type":"module",
  "description":"Data-driven offline build backend and static Ground RB decision workbench. No npm runtime dependencies.",
  "scripts":{
    "build":"python build.py",
    "build:decisions":"node scripts/build_decisions.mjs",
    "test":"npm run test:js && npm run test:python",
    "test:js":"node --test tests/engine.test.mjs tests/probability_summaries.test.mjs tests/data_client.test.mjs tests/meta-rankings.test.mjs",
    "test:python":"python tests/run_python_tests.py",
    "test:site":"python tests/run_python_tests.py --pattern test_site_build.py",
    "test:engine":"node tests/engine.test.mjs",
    "test:probabilities":"node tests/probability_summaries.test.mjs",
    "test:browser":"node tests/browser.e2e.mjs",
    "test:smoke":"node tests/site.smoke.mjs",
    "serve":"python scripts/serve.py --no-browser"
  },
  "devDependencies":{"playwright":"1.62.1"},
  "engines":{"node":">=20"}
}
